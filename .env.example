# Bitget API — get these from https://www.bitget.com/account/newapi
# Use a key with TRADE permission only. DISABLE withdrawal on this key.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSWORD=

# Trading mode: paper | dry | demo | live
# paper = simulated balance, no orders sent, runs without API keys
# dry   = no orders sent, decisions logged only
# demo  = REAL orders on Bitget DEMO account (virtual money, paptrading=1)
#         Get demo keys at https://www.bitget.com/asset/demo-trading
# live  = REAL orders on your real Bitget account (requires CONFIRM_LIVE=yes)
MODE=paper
CONFIRM_LIVE=no

# Symbol in ccxt format (Bitget USDT-M futures)
SYMBOL=BTC/USDT:USDT
TIMEFRAME=1h

# Strategy: sma_crossover | bollinger | rsi_mean_revert
STRATEGY=sma_crossover

# SMA crossover params
SMA_FAST=20
SMA_SLOW=50

# Bollinger breakout params (used when STRATEGY=bollinger)
BB_PERIOD=20
BB_STD=2.0

# RSI mean revert params (used when STRATEGY=rsi_mean_revert)
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70

# Risk per trade as a % of balance
RISK_PCT=2.0

# Stop loss and take profit as a % from entry price (0 = disabled).
# Checked on every tick locally — NOT placed as exchange-side stop orders.
STOP_LOSS_PCT=0
TAKE_PROFIT_PCT=0

# Paper-mode starting balance (USDT)
PAPER_BALANCE=1000

# Telegram notifier (optional — leave empty to disable)
# Create a bot with @BotFather, then get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Flask web UI
WEB_HOST=127.0.0.1
WEB_PORT=5000

# Logging
LOG_LEVEL=INFO
